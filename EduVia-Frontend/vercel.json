{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/EduVia-Frontend/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://eduvia-backend-4iqm.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://eduvia-backend-4iqm.onrender.com/auth/:path*"
    },
    {
      "source": "/notifications/:path*",
      "destination": "https://eduvia-backend-4iqm.onrender.com/notifications/:path*"
    },
    {
      "source": "/notifications",
      "destination": "https://eduvia-backend-4iqm.onrender.com/notifications"
    },
    {
      "source": "/ai/:path*",
      "destination": "https://eduvia-backend-4iqm.onrender.com/ai/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://eduvia-backend-4iqm.onrender.com/uploads/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://eduvia-backend-4iqm.onrender.com/health/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

